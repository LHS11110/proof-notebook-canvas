    "aba1d4ef-7fb3-4929-9fd9-3102d5e35d58": {
      "filename": "merge_sort.py",
      "height": 993.632573,
      "kind": "text",
      "language": "python",
      "renderMode": "code",
      "runtimeState": {
        "built": false,
        "completed": true,
        "failed": false,
        "language": "python",
        "phase": "run",
        "runId": "1794754357597-aba1d4ef-7fb3-4929-9fd9-3102d5e35d58",
        "running": false,
        "source": "def merge_sort(arr):\n    \"\"\"배열을 오름차순으로 정렬하는 병합 정렬 (재귀 구현)\"\"\"\n    if len(arr) <= 1:\n        return arr\n\n    # 중간 지점에서 배열을 둘로 분할\n    mid = len(arr) // 2\n    left = merge_sort(arr[:mid])\n    right = merge_sort(arr[mid:])\n\n    # 정렬된 두 부분 배열을 병합\n    return merge(left, right)\n\n\ndef merge(left, right):\n    \"\"\"정렬된 두 리스트를 하나의 정렬된 리스트로 병합\"\"\"\n    result = []\n    i = j = 0\n\n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            result.append(left[i])\n            i += 1\n        else:\n            result.append(right[j])\n            j += 1\n\n    # 남은 요소들 추가\n    result.extend(left[i:])\n    result.extend(right[j:])\n\n    return result\n\n\nif __name__ == \"__main__\":\n    sample = [5, 2, 9, 1, 5, 6, -3]\n    print(\"정렬 전:\", sample)\n    print(\"정렬 후:\", merge_sort(sample))\n",
        "status": "success",
        "updatedAt": 1794754359753
      },
      "text": "def merge_sort(arr):\n    \"\"\"배열을 오름차순으로 정렬하는 병합 정렬 (재귀 구현)\"\"\"\n    if len(arr) <= 1:\n        return arr\n\n    # 중간 지점에서 배열을 둘로 분할\n    mid = len(arr) // 2\n    left = merge_sort(arr[:mid])\n    right = merge_sort(arr[mid:])\n\n    # 정렬된 두 부분 배열을 병합\n    return merge(left, right)\n\n\ndef merge(left, right):\n    \"\"\"정렬된 두 리스트를 하나의 정렬된 리스트로 병합\"\"\"\n    result = []\n    i = j = 0\n\n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            result.append(left[i])\n            i += 1\n        else:\n            result.append(right[j])\n            j += 1\n\n    # 남은 요소들 추가\n    result.extend(left[i:])\n    result.extend(right[j:])\n\n    return result\n\n\nif __name__ == \"__main__\":\n    sample = [5, 2, 9, 1, 5, 6, -3]\n    print(\"정렬 전:\", sample)\n    print(\"정렬 후:\", merge_sort(sample))\n",
